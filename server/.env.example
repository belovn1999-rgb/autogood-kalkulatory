PORT=8790
HOST=127.0.0.1

# PartsLink24 credentials. Keep real values only on the server.
PARTSLINK24_COMPANY_ID=
PARTSLINK24_USERNAME=
PARTSLINK24_PASSWORD=
PARTSLINK24_DEFAULT_LANGUAGE=PL
PARTSLINK24_OUTPUT_DIR=/opt/autogood-vin/output
PARTSLINK24_MIN_RUN_GAP_MS=7000
PARTSLINK24_MAX_QUEUE_SIZE=4
PARTSLINK24_RUN_TIMEOUT_MS=240000

# Comma-separated browser origins. Use exact HTTPS domains in production.
AUTOGOOD_ALLOWED_ORIGINS=https://vin.example.com
AUTOGOOD_RELEASE=replace-with-git-tag-or-commit
AUTOGOOD_BUILD_TIME=

# Optional browser/runtime overrides.
PARTSLINK24_CHROME_PATH=
PARTSLINK24_PROFILE_DIR=
PARTSLINK24_DELAY_MIN_MS=650
PARTSLINK24_DELAY_MAX_MS=1600
PARTSLINK24_SLOW_MO_MS=350

MOBILEDE_CHROME_PATH=
MOBILEDE_CDP_URL=http://127.0.0.1:9333
MOBILEDE_CDP_PROFILE=
